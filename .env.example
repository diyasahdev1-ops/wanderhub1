# Backend API URL for frontend (leave blank for same-domain / relative routing on Vercel)
# In Vercel Production/Preview: Set to your backend URL if deployed separately (e.g. https://wanderhub-api.vercel.app)
VITE_API_URL=

# Google Gemini AI API Key (Required for AI generation - get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: Google Maps Platform JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=

# Server Port (Defaults to 3000)
PORT=3000

# Secret for user session tokens
JWT_SECRET=wanderhub-secret-key-change-in-production
